# ---- 세션/보안 ----
# 32자 이상 무작위 문자열. 예: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# ---- 카카오 로그인 (Kakao Developers > 내 애플리케이션 > 앱 키) ----
KAKAO_REST_API_KEY=여기에_REST_API_키
# 카카오 로그인 > 보안 > Client Secret 을 '사용함'으로 켰다면 입력, 아니면 비워둠
KAKAO_CLIENT_SECRET=
# 배포 주소. Kakao Developers의 Redirect URI와 정확히 같아야 함:
#   {SITE_URL}/.netlify/functions/member-auth/callback/kakao
SITE_URL=https://your-site.netlify.app

# ---- 추천(ref) 코드 → 표시 이름. JSON 한 줄 ----
REFERRALS={"db-3tc93":"정석","db-2r6zb":"민수"}

# ---- 네이버 뉴스 검색 API (developers.naver.com > 애플리케이션 등록 > 검색) ----
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---- 로컬 개발 전용(netlify 밖에서 npm run dev 할 때 파일 저장소 사용) ----
LOCAL_STORE_FILE=.data/store.json
